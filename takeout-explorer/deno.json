{
  "lint": {
    "exclude": [".vite", "node_modules"]
  },
  "tasks": {
    "gen-animations": "deno run -A ../vizsiteswap/runtime/convert.ts --input ../vizsiteswap/runtime/animations.ts --output public/animations.js",
    "dev": "deno task gen-animations && deno run -A --node-modules-dir npm:vite & deno task api:dev",
    "api:dev": "deno run -A --watch ./api/main.ts",
    "build": "deno task gen-animations && deno run -A --node-modules-dir npm:vite build",
    "serve": "deno task build && deno run -A ./api/main.ts",
    "preview": "deno run -A --node-modules-dir npm:vite preview"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "deno.ns"],
    "types": ["npm:@types/react@^18"]
  },
  "imports": {
    "vite": "npm:vite@^5.4.10",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4.3.3",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.2",
    "react": "npm:react@^18.3.1",
    "react/jsx-runtime": "npm:react@^18.3.1/jsx-runtime",
    "@types/react": "npm:@types/react@^18",
    "react-dom": "npm:react-dom@^18.3.1",
    "react-dom/client": "npm:react-dom@^18.3.1/client",
    "@oak/oak": "jsr:@oak/oak@^17",
    "@deno/emit": "jsr:@deno/emit@^0.46.0",
    "@svgdotjs/svg.js": "npm:@svgdotjs/svg.js@^3.2.4",
    "svgdom": "npm:svgdom@^0.1.19",
    "typescript-parsec": "npm:typescript-parsec@^0.3.4",
    "svg-path-properties": "npm:svg-path-properties@2.0.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@modernpassing/pattern": "../vizsiteswap/pattern/pattern.ts",
    "@modernpassing/parsing": "../vizsiteswap/parsing/parsing.ts",
    "@modernpassing/layout": "../vizsiteswap/layout/layout.ts",
    "@modernpassing/manipulation": "../vizsiteswap/manipulation/manipulation.ts",
    "@modernpassing/rendering-core": "../vizsiteswap/rendering-core/rendering.ts",
    "@modernpassing/rendering-svg": "../vizsiteswap/rendering-svg/renderer-svg.ts",
    "@modernpassing/svg-utils": "../vizsiteswap/svg-utils/svg-utils.ts"
  }
}
